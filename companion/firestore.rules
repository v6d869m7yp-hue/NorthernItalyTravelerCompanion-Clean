rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function tripDoc(tripId) { return get(/databases/$(database)/documents/trips/$(tripId)); }
    function isMember(tripId) { return signedIn() && request.auth.uid in tripDoc(tripId).data.memberUids; }
    function role(tripId) { return tripDoc(tripId).data.roles[request.auth.uid]; }
    function isOwner(tripId) { return isMember(tripId) && role(tripId) == 'owner'; }
    function canEdit(tripId) { return isMember(tripId) && role(tripId) in ['owner','editor']; }
    function inviteAfter(inviteId) { return getAfter(/databases/$(database)/documents/invitations/$(inviteId)); }
    function validInviteAcceptance(tripId) {
      let inviteId = request.resource.data.lastAcceptedInviteId;
      let invite = inviteAfter(inviteId);
      return signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && invite.data.tripId == tripId
        && invite.data.email == request.auth.token.email
        && invite.data.status == 'accepted'
        && invite.data.acceptedUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids','roles','travelers','lastAcceptedInviteId','updatedAt'])
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.roles[request.auth.uid] == invite.data.role;
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
      match /trips/{tripId} { allow read, write: if signedIn() && request.auth.uid == uid; }
      match /devices/{deviceId} { allow read, write: if signedIn() && request.auth.uid == uid; }
      match /vaultLocator/{documentId} { allow read, write: if signedIn() && request.auth.uid == uid; }
    }

    match /invitations/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['editor','viewer']
        && isOwner(request.resource.data.tripId);
      allow read: if signedIn() && (resource.data.inviterUid == request.auth.uid || resource.data.email == request.auth.token.email);
      allow update: if signedIn() && (
        (resource.data.inviterUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revokedAt','updatedAt'])
          && request.resource.data.status == 'revoked')
        ||
        (resource.data.email == request.auth.token.email
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedUid','acceptedAt','updatedAt'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedUid == request.auth.uid)
      );
      allow delete: if signedIn() && resource.data.inviterUid == request.auth.uid;
    }

    match /trips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.roles[request.auth.uid] == 'owner';
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow update: if (signedIn() && request.auth.uid in resource.data.memberUids && resource.data.roles[request.auth.uid] == 'owner') || validInviteAcceptance(tripId);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /envelopes/{envelopeId} { allow read: if isMember(tripId); allow create, update, delete: if canEdit(tripId); }
      match /reservations/{reservationId} { allow read: if isMember(tripId); allow create, update, delete: if canEdit(tripId); }
      match /documents/{documentId} { allow read: if isMember(tripId); allow create, update, delete: if canEdit(tripId); }
      match /journal/{entryId} { allow read: if isMember(tripId); allow create, update, delete: if canEdit(tripId); }
      match /activity/{entryId} { allow read: if isMember(tripId); allow create: if canEdit(tripId) && request.resource.data.actorUid == request.auth.uid; allow update, delete: if false; }
      match /members/{uid} { allow read: if isMember(tripId); allow write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
